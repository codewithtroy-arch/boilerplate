# Get these from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL used for magic-link redirects (set to your Vercel URL in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add per-app as needed:
# Catalog app Paystack payment — get both from Paystack Dashboard > Settings > API Keys & Webhooks
# Use TEST keys (pk_test_.../sk_test_...) while building, switch to LIVE keys only when ready for real payments.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Secret key — server-only, NEVER put NEXT_PUBLIC_ prefix on this one, it must stay private.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Note: there's no ADMIN_EMAIL variable anymore — admin access is now
# determined by the profiles table (first person to sign up = admin).
# See supabase/roles_migration.sql.

# Service role key — Supabase Project Settings > API Keys > service_role.
# SERVER-ONLY. This key bypasses all security rules — never expose it to
# the browser, never prefix with NEXT_PUBLIC_. Used to record orders and
# adjust stock for anonymous customers who aren't logged in.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — for the AI product description writer in admin.
# Get one at console.anthropic.com. Server-only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Note: business name, tagline, and WhatsApp number are no longer set
# here — they're entered during /setup and editable anytime in
# /admin/settings, stored in the database instead of env vars.
