# Get these from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL used for magic-link redirects (set to your Vercel URL in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add per-app as needed:
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Catalog & WhatsApp Checkout app:
# Merchant's WhatsApp number in international format, no + or spaces
# e.g. Nigerian number 0803 123 4567 becomes 2348031234567
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
